# Supabase Dashboard > Project Settings > API. These two values are public.
NEXT_PUBLIC_APP_URL=
# Required at production build and runtime: the real public HTTPS application origin.
# Leave blank only for local development; rebuild when changing the production origin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, HOSTED server ONLY. Used for self-service account deletion and claimed draft cleanup.
# Never configure these privileged keys in an Electron build or alongside its executable.
# SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=

# CLI deployment: set SUPABASE_ACCESS_TOKEN in your shell, or run npx supabase login.
# Never prefix secret keys, access tokens, or passwords with NEXT_PUBLIC_.

# Optional GIPHY browser API key (public client key; no privileged provider credential).
# GIPHY requires client-side trending requests. Use your own production-approved key.
NEXT_PUBLIC_GIPHY_API_KEY=

# Public WebSocket destination; the gateway must run protocol v2 with an RLS authorizer.
NEXT_PUBLIC_GATEWAY_URL=

# Desktop forwarding locations (nonsecret). Provision the hosted Next API before setting these.
# Example shape: https://your-chat-domain.example/api/account and https://your-chat-domain.example
CHATFLOW_ACCOUNT_API_URL=
CHATFLOW_ACCOUNT_API_ALLOWED_ORIGINS=
# CHATFLOW_RUNTIME and CHATFLOW_DESKTOP_ORIGIN are set by Electron main; do not set them here.

# Gateway host only: SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY or supported public-key aliases.
# Gateway uses the public project key and each verified user's JWT to enforce database RLS.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# UPLOAD_DIR=
# Optional separate capability-signing secret >=32 characters, gateway host only.
# GATEWAY_DOWNLOAD_SECRET=
