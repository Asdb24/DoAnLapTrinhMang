# Supabase Dashboard > Project Settings > API. These two values are public.
NEXT_PUBLIC_APP_URL=
# Required at production build and runtime: the real public HTTPS application origin.
# Leave blank only for local development; rebuild when changing the production origin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, server ONLY. Needed only for self-service account deletion.
# SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=

# CLI deployment: set SUPABASE_ACCESS_TOKEN in your shell, or run npx supabase login.
# Never prefix secret keys, access tokens, or passwords with NEXT_PUBLIC_.

# Optional GIPHY browser API key (public client key; no privileged provider credential).
# GIPHY requires client-side trending requests. Use your own production-approved key.
NEXT_PUBLIC_GIPHY_API_KEY=
